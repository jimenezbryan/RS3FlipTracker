{
  "name": "flipsync-demo-video",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "studio": "NODE_PATH=./node_modules remotion studio",
    "render": "NODE_PATH=./node_modules remotion render Demo out/raw.mp4 && ffmpeg -v error -y -i out/raw.mp4 -c:v copy -af loudnorm=I=-16:TP=-1.5:LRA=11 -c:a aac -b:a 192k -movflags +faststart out/flipsync-demo.mp4",
    "still": "NODE_PATH=./node_modules remotion still Demo",
    "vo": "node scripts/generate-vo.mjs",
    "music": "python3 scripts/make-audio.py"
  },
